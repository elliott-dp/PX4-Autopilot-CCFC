#!/bin/sh
# shellcheck disable=SC2154

# CCFC fork: default every instance to MAVLink 2 output so streams and
# heartbeats leave the boot in v2 (the CC link is MAVLink 2 by contract,
# spec §3) instead of starting v1 and upgrading on first v2 RX.
# NOTE: this does NOT change PX4's TIMESYNC reply, which the shared timesync
# module still emits as MAVLink 1 from the receiver thread regardless of this
# param (verified against SITL). The companion decoder accepts both framings;
# CC_* telemetry (24-bit IDs) is MAVLink 2 exclusively by construction.
param set MAV_PROTO_VER 2

udp_offboard_port_local=$((14580+px4_instance))
udp_offboard_port_remote=$((14540+px4_instance))
[ "$px4_instance" -gt 9 ] && udp_offboard_port_remote=14549 # use the same ports for more than 10 instances to avoid port overlaps
udp_onboard_payload_port_local=$((14280+px4_instance))
udp_onboard_payload_port_remote=$((14030+px4_instance))
udp_onboard_gimbal_port_local=$((13030+px4_instance))
udp_onboard_gimbal_port_remote=$((13280+px4_instance))
udp_gcs_port_local=$((18570+px4_instance))

# GCS link
mavlink start -x -u $udp_gcs_port_local -r 4000000 -f
mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u $udp_gcs_port_local
mavlink stream -r 50 -s LOCAL_POSITION_NED -u $udp_gcs_port_local
mavlink stream -r 50 -s GLOBAL_POSITION_INT -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE_QUATERNION -u $udp_gcs_port_local
mavlink stream -r 50 -s ATTITUDE_TARGET -u $udp_gcs_port_local
mavlink stream -r 50 -s SERVO_OUTPUT_RAW_0 -u $udp_gcs_port_local
mavlink stream -r 20 -s RC_CHANNELS -u $udp_gcs_port_local
mavlink stream -r 10 -s OPTICAL_FLOW_RAD -u $udp_gcs_port_local

# API/Offboard link
mavlink start -x -u $udp_offboard_port_local -r 4000000 -f -m onboard -o $udp_offboard_port_remote

# Onboard link to camera
mavlink start -x -u $udp_onboard_payload_port_local -r 4000 -f -m onboard -o $udp_onboard_payload_port_remote

# Onboard link to gimbal
mavlink start -x -u $udp_onboard_gimbal_port_local -r 400000 -f -m gimbal -o $udp_onboard_gimbal_port_remote

# CCFC fork: companion-computer link (spec §2.2 UDP variant for SITL).
# Onboard mode per spec §2.1; CC_* stream rates follow the AI_UART profile
# (uORB decimation in cc_telemetry_publisher is the authority, these are
# ceilings — spec §4.3). Harness listens on the remote port (udpin).
udp_ccfc_port_local=$((24540+px4_instance))
udp_ccfc_port_remote=$((24040+px4_instance))
# custom mode = no default stream set: the wire carries ONLY the CC_*
# contract + HEARTBEAT (spec §8 budget); onboard mode's default streams
# from the newer submodule dialect were noise our pinned dialect can't
# decode (and PX4's own 10 Hz TIMESYNC requests are unnecessary — the
# companion drives the sync, PX4 answers)
mavlink start -x -u $udp_ccfc_port_local -r 400000 -m custom -o $udp_ccfc_port_remote
mavlink stream -r 1 -s HEARTBEAT -u $udp_ccfc_port_local
mavlink stream -r 25 -s CC_TELEMETRY_STATE -u $udp_ccfc_port_local
mavlink stream -r 50 -s CC_TELEMETRY_IMU -u $udp_ccfc_port_local
mavlink stream -r 10 -s CC_TELEMETRY_POWER -u $udp_ccfc_port_local
mavlink stream -r 5 -s CC_TELEMETRY_GPS -u $udp_ccfc_port_local
mavlink stream -r 10 -s CC_TELEMETRY_ESTIMATOR -u $udp_ccfc_port_local
mavlink stream -r 20 -s CC_TELEMETRY_ACTUATOR -u $udp_ccfc_port_local
mavlink stream -r 25 -s CC_EVENT -u $udp_ccfc_port_local
mavlink stream -r 25 -s CC_SAFETY_STATUS -u $udp_ccfc_port_local

# To display for SIH sitl
if [ "$PX4_SIMULATOR" = "sihsim" ]; then
	udp_sihsim_port_local=$((19450+px4_instance))
	udp_sihsim_port_remote=$((19410+px4_instance))
	mavlink start -x -u $udp_sihsim_port_local -r 400000 -m custom -o $udp_sihsim_port_remote
	mavlink stream -r 200 -s HIL_ACTUATOR_CONTROLS -u  $udp_sihsim_port_local
	mavlink stream -r 25 -s HIL_STATE_QUATERNION -u  $udp_sihsim_port_local
fi
